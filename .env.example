POSTGRES_DB=browser_history
POSTGRES_USER=browser_history
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql+psycopg://browser_history:change-this-password@db:5432/browser_history

# Development-only shared credentials.
# Extension enrollment still uses a shared token.
DEV_EXTENSION_TOKEN=replace-with-a-long-random-extension-token
AUTH_MODE=development
DEV_ADMIN_TOKEN=replace-with-a-long-random-admin-token

CORS_ORIGINS=http://localhost:5173

# Set AUTH_MODE=google to enable Workspace sign-in and disable admin-token access.
# OAuth client type: Web application. No client secret is used by this flow.
GOOGLE_CLIENT_ID=
# Comma-separated verified Google Workspace hosted domains (no wildcards).
GOOGLE_WORKSPACE_DOMAINS=
# Comma-separated exact administrator email addresses (no wildcards).
ADMIN_EMAILS=
