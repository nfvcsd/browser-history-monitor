{
  "manifest_version": 3,
  "name": "Managed Browser History Agent",
  "version": "0.2.0",
  "description": "Synchronizes managed history and estimates active foreground browsing time.",
  "minimum_chrome_version": "120",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "identity",
    "identity.email",
    "tabs",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://history.nfv.k12.ia.us/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "schema.json"
  }
}
